{
    "name": "LLM Project DevContainer",
    "dockerComposeFile": "docker-compose.yml",
    "features": {
        "ghcr.io/devcontainers-extra/features/pipenv": {}
    },
    "customizations": {
        "settings": {
            "terminal.integrated.shell.linux": "/bin/bash"
        },
        "extensions": [
            "ms-python.python",
            "ms-python.debugpy",
            "ms-python.isort",
            "ms-python.black-formatter",
            "ms-python.linter-bandit",
            "ms-azuretools.vscode-docker",
            "ms-vscode-remote.vscode-remote-extensionpack",
            "HuggingFace.huggingface-vscode"
        ]
    },
    "postCreateCommand": "pip install -U -r requirements.txt",
    "remoteUser": "vscode"
}
