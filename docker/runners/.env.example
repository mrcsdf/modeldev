# Environment configuration for GitHub Actions runners
# Copy this file to .env and fill in your values

# GitHub repository URL (required)
REPO_URL=https://github.com/owner/repo

# GitHub authentication (choose ONE method):
# METHOD 1: Registration token (get from GitHub repo → Settings → Actions → Runners)
# GITHUB_TOKEN=your_registration_token_here

# METHOD 2: GitHub CLI (preferred - run 'gh auth login' on host first)
# No token needed - will use your GitHub login automatically

# METHOD 3: Personal Access Token (alternative)
# GITHUB_TOKEN=ghp_your_personal_access_token_here

# Runner configuration (optional)
RUNNER_NAME=github-runner-1
RUNNER_LABELS=linux,docker,self-hosted,llm
RUNNER_GROUP=default

# LM Studio configuration (optional - defaults to localhost)
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio

# Docker configuration (optional)
COMPOSE_PROJECT_NAME=github-runners
