FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install base packages and development tools, create runner user
RUN apt-get update && apt-get install -y \
    apt-transport-https \
    build-essential \
    ca-certificates \
    curl \
    docker.io \
    git \
    gnupg \
    jq \
    lsb-release \
    python3 \
    python3-pip \
    python3-venv \
    software-properties-common \
    sudo \
    unzip \
    wget \
    zip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -s /bin/bash runner \
    && echo "runner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && usermod -aG docker runner

# Install Node.js 20 from NodeSource before switching to runner user
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

# Install Node.js packages globally as root
RUN npm install -g \
    @typescript-eslint/eslint-plugin \
    @typescript-eslint/parser \
    eslint \
    prettier \
    ts-node \
    typescript

# Install mise for tool management and setup tools
USER runner
WORKDIR /home/runner
RUN curl https://mise.run | sh
ENV PATH="/home/runner/.local/bin:$PATH"

# Create default mise configuration
RUN echo '[tools]' > /home/runner/.mise.toml && \
    echo 'python = "3.12"' >> /home/runner/.mise.toml && \
    echo 'node = "lts"' >> /home/runner/.mise.toml && \
    echo '' >> /home/runner/.mise.toml && \
    echo '[settings]' >> /home/runner/.mise.toml && \
    echo 'auto_install = true' >> /home/runner/.mise.toml

# Install mise tools but don't fail if it doesn't work
RUN mise install || echo "Mise install failed, will use system tools"

# Download and install GitHub Actions runner
ADD --chown=runner:runner https://github.com/actions/runner/releases/download/v2.311.0/actions-runner-linux-x64-2.311.0.tar.gz /home/runner/actions-runner-linux-x64.tar.gz

# Extract runner
RUN tar xzf actions-runner-linux-x64.tar.gz && \
    rm actions-runner-linux-x64.tar.gz

# Install Python packages using system Python
RUN python3 -m pip install --user \
    bandit \
    black \
    coverage \
    flake8 \
    isort \
    mypy \
    openai \
    pre-commit \
    pytest \
    requests \
    safety

# Create devtools directory and default entrypoint
RUN sudo mkdir -p /usr/local/bin/devtools && \
    echo '#!/bin/bash' > /home/runner/entrypoint.sh && \
    echo 'set -e' >> /home/runner/entrypoint.sh && \
    echo 'echo "Starting GitHub Actions Runner..."' >> /home/runner/entrypoint.sh && \
    echo '# Validate required environment variables' >> /home/runner/entrypoint.sh && \
    echo 'if [ -z "$REPO_URL" ]; then' >> /home/runner/entrypoint.sh && \
    echo '    echo "Error: REPO_URL environment variable is required"' >> /home/runner/entrypoint.sh && \
    echo '    exit 1' >> /home/runner/entrypoint.sh && \
    echo 'fi' >> /home/runner/entrypoint.sh && \
    echo 'if [ -z "$REGISTRATION_TOKEN" ]; then' >> /home/runner/entrypoint.sh && \
    echo '    echo "Error: REGISTRATION_TOKEN environment variable is required"' >> /home/runner/entrypoint.sh && \
    echo '    exit 1' >> /home/runner/entrypoint.sh && \
    echo 'fi' >> /home/runner/entrypoint.sh && \
    echo '# Configure runner if not already configured' >> /home/runner/entrypoint.sh && \
    echo 'if [ ! -f .runner ]; then' >> /home/runner/entrypoint.sh && \
    echo '    echo "Configuring runner..."' >> /home/runner/entrypoint.sh && \
    echo '    ./config.sh --url "$REPO_URL" --token "$REGISTRATION_TOKEN" --name "${RUNNER_NAME:-$(hostname)}" --labels "${RUNNER_LABELS:-linux,docker,self-hosted}" --work "_work" --unattended --replace' >> /home/runner/entrypoint.sh && \
    echo 'fi' >> /home/runner/entrypoint.sh && \
    echo '# Start the runner' >> /home/runner/entrypoint.sh && \
    echo 'echo "Starting runner..."' >> /home/runner/entrypoint.sh && \
    echo 'exec ./run.sh' >> /home/runner/entrypoint.sh && \
    chmod +x /home/runner/entrypoint.sh

# Set up environment variables
ENV MISE_DATA_DIR=/home/runner/.local/share/mise
ENV MISE_CONFIG_DIR=/home/runner/.config/mise
ENV PATH="/home/runner/.local/share/mise/shims:$PATH"

# Configure Git and create workspace directory
RUN git config --global user.name "GitHub Actions Runner" && \
    git config --global user.email "runner@localhost" && \
    git config --global init.defaultBranch main && \
    git config --global core.autocrlf false && \
    mkdir -p /home/runner/_work

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=1m --retries=3 \
    CMD pgrep -f "Runner.Listener" || exit 1

# Set working directory
WORKDIR /home/runner

# Run as runner user
USER runner

# Default entrypoint
ENTRYPOINT ["/home/runner/entrypoint.sh"]
