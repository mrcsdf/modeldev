#!/usr/bin/env bash
set -euo pipefail

# Global pre-commit hook - runs formatting and linting
# Applies to every repository using the global Git template

# Skip in CI environments
[ -n "${CI:-}" ] && exit 0

echo "🔍 Running pre-commit checks..."

# Use pre-commit if repo has configuration
if [ -f ".pre-commit-config.yaml" ]; then
    if command -v pre-commit >/dev/null 2>&1; then
        echo "📋 Running pre-commit hooks..."
        pre-commit run --hook-stage pre-commit --all-files
        exit $?
    else
        echo "⚠️  pre-commit not installed. Install with: pip install pre-commit"
        echo "💡 Falling back to basic checks..."
    fi
fi

# Fallback: minimal checks by file type
echo "🔧 Running fallback checks by file type..."

# Get staged files by type
PY_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)
SH_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.sh$' || true) 
PS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ps1$' || true)
TF_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.tf$' || true)
YML_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.ya?ml$' || true)
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts|jsx|tsx)$' || true)
JSON_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.json$' || true)

# Shell script formatting and linting
if [ -n "$SH_FILES" ]; then
    echo "🐚 Checking shell scripts..."
    if command -v shfmt >/dev/null 2>&1; then
        shfmt -w -i 2 -sr -kp $SH_FILES
        echo "✅ Shell scripts formatted"
    fi
    if command -v shellcheck >/dev/null 2>&1; then
        shellcheck -x $SH_FILES
        echo "✅ Shell scripts linted"
    fi
fi

# Python formatting and linting
if [ -n "$PY_FILES" ]; then
    echo "🐍 Checking Python files..."
    if command -v black >/dev/null 2>&1; then
        black --quiet $PY_FILES
        echo "✅ Python files formatted with black"
    fi
    if command -v isort >/dev/null 2>&1; then
        isort --quiet $PY_FILES
        echo "✅ Python imports sorted"
    fi
    if command -v flake8 >/dev/null 2>&1; then
        flake8 $PY_FILES
        echo "✅ Python files linted with flake8"
    fi
    if command -v bandit >/dev/null 2>&1; then
        bandit -q -r $(dirname $PY_FILES | sort -u) 2>/dev/null || true
        echo "✅ Python security check completed"
    fi
fi

# PowerShell linting
if [ -n "$PS_FILES" ]; then
    echo "💙 Checking PowerShell files..."
    if command -v pwsh >/dev/null 2>&1; then
        for ps_file in $PS_FILES; do
            pwsh -NoLogo -NoProfile -Command "
                if (Get-Module -ListAvailable PSScriptAnalyzer) {
                    Invoke-ScriptAnalyzer -Path '$ps_file' -Severity Warning,Error
                } else {
                    Write-Host 'PSScriptAnalyzer not available'
                }
            " || true
        done
        echo "✅ PowerShell files checked"
    fi
fi

# Terraform formatting and validation
if [ -n "$TF_FILES" ]; then
    echo "🏗️  Checking Terraform files..."
    if command -v terraform >/dev/null 2>&1; then
        terraform fmt -recursive || true
        echo "✅ Terraform files formatted"
    fi
    if command -v tflint >/dev/null 2>&1; then
        tflint --init >/dev/null 2>&1 || true
        tflint || true
        echo "✅ Terraform files linted"
    fi
fi

# YAML linting
if [ -n "$YML_FILES" ]; then
    echo "📄 Checking YAML files..."
    if command -v yamllint >/dev/null 2>&1; then
        yamllint $YML_FILES || true
        echo "✅ YAML files linted"
    fi
    # Check for Ansible playbooks
    if command -v ansible-lint >/dev/null 2>&1 && ([ -f "ansible.cfg" ] || [ -d "playbooks" ] || [ -d "roles" ]); then
        ansible-lint || true
        echo "✅ Ansible files linted"
    fi
fi

# JavaScript/TypeScript formatting and linting
if [ -n "$JS_FILES" ]; then
    echo "🟨 Checking JavaScript/TypeScript files..."
    if command -v prettier >/dev/null 2>&1; then
        prettier --write $JS_FILES
        echo "✅ JS/TS files formatted with Prettier"
    fi
    if command -v eslint >/dev/null 2>&1; then
        eslint --fix $JS_FILES || true
        echo "✅ JS/TS files linted with ESLint"
    fi
fi

# JSON formatting
if [ -n "$JSON_FILES" ]; then
    echo "📊 Checking JSON files..."
    if command -v jq >/dev/null 2>&1; then
        for json_file in $JSON_FILES; do
            jq . "$json_file" > "$json_file.tmp" && mv "$json_file.tmp" "$json_file"
        done
        echo "✅ JSON files formatted"
    fi
fi

# Re-stage formatted files
if [ -n "$SH_FILES$PY_FILES$JS_FILES$JSON_FILES$TF_FILES" ]; then
    git add $SH_FILES $PY_FILES $JS_FILES $JSON_FILES $TF_FILES 2>/dev/null || true
    echo "📝 Re-staged formatted files"
fi

echo "✅ Pre-commit checks completed successfully!"