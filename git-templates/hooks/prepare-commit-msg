#!/usr/bin/env bash
set -euo pipefail

# Global prepare-commit-msg hook
# Provides a standardized commit message template

FILE="$1"
SOURCE="${2:-}"
SHA="${3:-}"

# Don't modify if message already exists (e.g., merge commits, amend, etc.)
if [ -s "$FILE" ]; then
    exit 0
fi

# Don't modify for merge commits
if [ "$SOURCE" = "merge" ]; then
    exit 0
fi

# Check if this is a conventional commit already
if [ -n "$SOURCE" ] && [ "$SOURCE" != "template" ]; then
    exit 0
fi

# Generate template based on branch name and repository state
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
REPO_NAME=$(basename "$(git rev-parse --show-toplevel)" 2>/dev/null || echo "repo")

# Try to infer commit type from files changed
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)
COMMIT_TYPE="feat"

if [ -n "$STAGED_FILES" ]; then
    # Determine commit type based on files
    if echo "$STAGED_FILES" | grep -qE '\.(md|txt|rst)$'; then
        COMMIT_TYPE="docs"
    elif echo "$STAGED_FILES" | grep -qE '(test|spec)'; then
        COMMIT_TYPE="test"
    elif echo "$STAGED_FILES" | grep -qE '\.(json|ya?ml|toml|cfg|ini|conf)$'; then
        COMMIT_TYPE="config"
    elif echo "$STAGED_FILES" | grep -qE '(Dockerfile|docker-compose|\.dockerignore)'; then
        COMMIT_TYPE="build"
    elif echo "$STAGED_FILES" | grep -qE '\.(tf|tfvars)$'; then
        COMMIT_TYPE="infra"
    elif echo "$STAGED_FILES" | grep -qE '(requirements|pyproject|package\.json|Cargo\.toml|go\.mod)'; then
        COMMIT_TYPE="deps"
    elif echo "$STAGED_FILES" | grep -qE '\.(py|js|ts|go|rs|java|cpp|c|h)$'; then
        # Check if it's likely a fix
        if git diff --cached | grep -qE '^[-+].*\b(fix|bug|error|issue)\b'; then
            COMMIT_TYPE="fix"
        else
            COMMIT_TYPE="feat"
        fi
    fi
fi

# Generate commit message template
cat > "$FILE" <<EOF
$COMMIT_TYPE: 

# Conventional Commits format:
# <type>[optional scope]: <description>
#
# [optional body]
#
# [optional footer(s)]
#
# Types:
# feat:     A new feature
# fix:      A bug fix
# docs:     Documentation only changes
# style:    Changes that do not affect the meaning of the code
# refactor: A code change that neither fixes a bug nor adds a feature
# perf:     A code change that improves performance
# test:     Adding missing tests or correcting existing tests
# build:    Changes that affect the build system or external dependencies
# ci:       Changes to our CI configuration files and scripts
# chore:    Other changes that don't modify src or test files
# revert:   Reverts a previous commit
#
# Examples:
# feat: add user authentication
# fix: resolve memory leak in data processing
# docs: update API documentation
# feat(auth): add OAuth2 integration
#
# Branch: $BRANCH
# Files: $STAGED_FILES
EOF